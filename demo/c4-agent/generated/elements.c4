// AI-managed — fully regenerated by likec4-agent sync on every run.
// Do not hand-edit; your changes will be overwritten on the next sync.
model {
  logging-service = container 'Logging Service' {
    technology 'Go'
    description 'Logging Gateway Service'
  }

  orders-service = container 'Orders Service Updated2' {
    technology 'Node.js, Express'
    description 'Accepts incoming order requests, validates them, charges the customer, and publishes a fulfillment event once payment succeeds.'
  }

  payments-service = container 'Payments Service' {
    technology 'Node.js, Express'
    description 'Charges customer payment methods via the Stripe API and records the resulting transaction.'
  }

  extend payments-service {
    payment-validator = component 'Payment Validator' {
      technology 'TypeScript'
      description 'Validates card details before a charge is attempted.'
    }
  }
}
